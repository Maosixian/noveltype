{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.github.maosixian.noveltype",
  "productName": "NovelType",
  "asar": true,
  "npmRebuild": false,
  "directories": { "output": "dist" },
  "files": [
    "app/main.cjs", "app/preload.cjs", "app/library.cjs", "app/security.cjs",
    "app/translation.cjs", "app/typing.mjs", "app/stream.mjs", "app/renderer.js", "app/inline-typing.mjs",
    "app/alignment.cjs", "app/alignment.mjs", "app/demo-alignment.cjs", "app/practice.cjs",
    "app/games.mjs", "app/games-ui.mjs", "app/games.css", "app/game-content.cjs", "app/game-store.cjs", "app/race-results.cjs", "app/progress-save.cjs", "app/appearance.css",
    "app/index.html", "app/styles.css", "app/presentation.mjs", "app/typing-feedback.mjs", "app/typing-feedback.css", "app/chapters.mjs", "app/chapter-feedback.mjs", "app/chapter-feedback.css", "app/assets/arcade-world.png", "package.json", "使用说明.md"
    , "app/cloud-client.cjs", "app/cloud-library.cjs", "app/cloud-workspace.cjs", "app/account-ui.mjs"
  ],
  "artifactName": "NovelType-${version}-win-${arch}.${ext}",
  "publish": null,
  "win": {
    "icon": "app/assets/app-icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "artifactName": "NovelType-Setup-${version}-${arch}.${ext}",
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "逐页英文打字",
    "runAfterFinish": false,
    "installerLanguages": ["zh_CN", "en_US"]
  }
}
