{
  "name": "noveltype",
  "productName": "NovelType",
  "version": "1.2.1",
  "description": "Read stories. Type English. A private desktop novel typing tutor.",
  "main": "app/main.cjs",
  "author": "Xavier",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maosixian/noveltype.git"
  },
  "bugs": {
